<Window x:Class="GalLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GalLens" Height="640" Width="900" MinHeight="560" MinWidth="820"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
  <DockPanel x:Name="Root" Margin="16,12,16,14" LastChildFill="True">

    <Grid DockPanel.Dock="Top" Margin="2,0,0,12">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="GalLens" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="屏幕实时汉化" Style="{StaticResource Dim}" VerticalAlignment="Bottom" Margin="8,0,0,3"/>
      </StackPanel>
      <Button Content="帮助" Width="64" Height="30" HorizontalAlignment="Right" Click="Help_Click"/>
    </Grid>

    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Button x:Name="StartButton" Grid.Column="0" Content="开始翻译" Style="{StaticResource Primary}"
              Width="118" Height="38" Click="StartStop_Click"/>
      <Button x:Name="RetranslateButton" Grid.Column="1" Content="重译" Width="78" Height="38"
              Margin="8,0,0,0" Click="Retranslate_Click" IsEnabled="False"/>
      <Button x:Name="VisionButton" Grid.Column="2" Content="图像翻译" Width="88" Height="38"
              Margin="8,0,0,0" Click="Vision_Click" IsEnabled="False"/>
      <TextBlock x:Name="StatusText" Grid.Column="3" VerticalAlignment="Center" Margin="14,0,10,0"
                 Style="{StaticResource Dim}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Grid.Column="4" Text="by ymkdr" Style="{StaticResource Dim}" VerticalAlignment="Center" Opacity="0.55"/>
    </Grid>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="370"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,12,0">

          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="游戏窗口" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <ComboBox x:Name="WindowCombo" SelectionChanged="WindowCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="刷新列表" Click="Refresh_Click" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Content="框选台词区域" Click="PickRegion_Click" Margin="4,0,0,0"/>
              </Grid>
              <TextBlock x:Name="WindowText" Style="{StaticResource Dim}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="RegionText" Style="{StaticResource Dim}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14">
            <StackPanel>
              <TextBlock Text="字幕外观" FontWeight="SemiBold" Margin="0,0,0,10"/>

              <ComboBox x:Name="FontCombo" SelectionChanged="FontCombo_Changed">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="15"
                               TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="字号" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="FontSizeText" Text="28" HorizontalAlignment="Right"
                           Style="{StaticResource Dim}" VerticalAlignment="Center"/>
              </Grid>
              <Slider x:Name="FontSlider" Minimum="14" Maximum="64" Value="28" IsMoveToPointEnabled="True"
                      ValueChanged="FontSlider_Changed"/>

              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="Sw0" Tag="#FFFFFF" Width="28" Height="24" Margin="0,0,8,0" Background="#FFFFFF" Click="Color_Click"/>
                <Button x:Name="Sw1" Tag="#FFEFC0" Width="28" Height="24" Margin="0,0,8,0" Background="#FFEFC0" Click="Color_Click"/>
                <Button x:Name="Sw2" Tag="#CFE3FF" Width="28" Height="24" Margin="0,0,8,0" Background="#CFE3FF" Click="Color_Click"/>
                <Button x:Name="Sw3" Tag="#D8F7D8" Width="28" Height="24" Margin="0,0,8,0" Background="#D8F7D8" Click="Color_Click"/>
                <Button x:Name="Sw4" Tag="#FFD9E6" Width="28" Height="24" Background="#FFD9E6" Click="Color_Click"/>
                <CheckBox x:Name="OutlineCheck" Content="描边" Foreground="#C9C9D6" FontSize="12"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          Checked="Outline_Changed" Unchecked="Outline_Changed"/>
              </StackPanel>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="背景不透明度" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" x:Name="OpacityText" Text="0.66" HorizontalAlignment="Right"
                           Style="{StaticResource Dim}" VerticalAlignment="Center"/>
              </Grid>
              <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="0.66" IsMoveToPointEnabled="True"
                      ValueChanged="OpacitySlider_Changed"/>

              <Button x:Name="MoveButton" Content="移动字幕位置" Margin="0,12,0,0" Click="MoveOverlay_Click"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1">
          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="翻译服务" FontWeight="SemiBold" Margin="0,0,0,10"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="46"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="地址" Style="{StaticResource Dim}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="Key" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Grid.Row="2" Text="模型" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <TextBox x:Name="BaseUrlBox" Grid.Column="1" TextChanged="Config_Changed"/>
                <PasswordBox x:Name="ApiKeyBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" PasswordChanged="ApiKey_Changed"/>
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                  <TextBox x:Name="ModelBox" TextChanged="Config_Changed" Padding="6,5,30,5"/>
                  <Button x:Name="ModelPresetButton" Content="▾" Width="30" HorizontalAlignment="Right"
                          Background="Transparent" Padding="0" Click="ModelPreset_Click"/>
                </Grid>
              </Grid>
              <CheckBox x:Name="VisionCheck" Content="OCR 不可靠时改用图像识别"
                        Foreground="#C9C9D6" FontSize="12" Margin="0,10,0,0"
                        Checked="Vision_Changed" Unchecked="Vision_Changed"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <StackPanel>
              <Grid>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="术语表" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock x:Name="GlossarySummary" Text="0 条" Style="{StaticResource Dim}"
                             VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="GlossaryToggleButton" Content="展开" Padding="10,3" FontSize="11"
                          Click="GlossaryToggle_Click"/>
                  <Button x:Name="GlossaryEditButton" Content="编辑" Padding="10,3" FontSize="11"
                          Margin="6,0,0,0" Visibility="Collapsed" Click="GlossaryEdit_Click"/>
                  <Button Content="清空" Padding="10,3" FontSize="11" Margin="6,0,0,0"
                          Click="ClearGlossary_Click"/>
                </StackPanel>
              </Grid>

              <ListBox x:Name="GlossaryList" Height="104" Margin="0,8,0,0" Visibility="Collapsed"
                       Background="#22222A" Foreground="#DDDDE6" BorderBrush="#33333D" FontSize="12"/>

              <TextBox x:Name="GlossaryBox" Height="88" Margin="0,8,0,0" Visibility="Collapsed"
                       AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                       TextChanged="Config_Changed"/>
              <TextBlock x:Name="GlossaryEmptyHint" Text="（空）" Style="{StaticResource Dim}"
                         Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="14">
            <StackPanel>
              <Grid>
                <TextBlock Text="识别与译文" FontWeight="SemiBold"/>
                <TextBlock x:Name="LatencyText" Style="{StaticResource Dim}" HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock x:Name="SourceText" TextWrapping="Wrap" Margin="0,8,0,8" MinHeight="28"
                         Foreground="#B9B9C6" FontSize="12"/>
              <TextBlock x:Name="TargetText" TextWrapping="Wrap" MinHeight="42"
                         FontSize="15" Foreground="#9FB6FF"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
